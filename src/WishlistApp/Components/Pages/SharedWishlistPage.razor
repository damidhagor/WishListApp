@page "/w/{accessKey}"
@rendermode @(new InteractiveServerRenderMode(false))
@attribute [AllowAnonymous]

<PageTitle>@Wishlist?.Name</PageTitle>

<div>
    @if (Wishlist is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlist ...
        </div>
    }
    else
    {
        <WishlistComponent Wishlist="@Wishlist" WishlistShare="@WishlistShare" />

        <div class="border border-secondary mt-4 mb-4"></div>

        <WishlistShareComponent Wishlist="@Wishlist" />
    }
</div>
