@page "/editwishlist"
@rendermode RenderMode.InteractiveServer

<PageTitle>@Wishlist?.Name</PageTitle>

<h1>
    <TextInputToggle Value="@Wishlist?.Name">
        @Wishlist?.Name
    </TextInputToggle>
</h1>

<div class="border border-secondary"></div>

<div>
    @if (Wishlist is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlist ...
        </div>
    }
    else
    {
        <div class="list-group-flush list-group-hover mb-4">
            @foreach (var item in Wishlist.Items)
            {
                <div class="list-group-item container-fluid">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4>
                                <a href="@item.Url" class="stretched-link" target="_blank" rel="noopener noreferrer">@item.Url</a>
                            </h4>
                            <h5>
                                Loaded Site Content
                            </h5>
                        </div>

                        <div class="col col-auto align-center" style="z-index: 100">
                            <div class="mb-2">
                                <input class="form-check-input" type="checkbox" @bind:get="item.IsBought" @bind:set="((value) => SetIsBought(item, value))" id="isBoughtCheck-@item.Id">
                                <label class="form-check-label" for="isBoughtCheck-@item.Id">
                                    Is Bought
                                </label>
                            </div>

                            <button type="button" class="btn btn-outline-danger" @onclick="@(async () => await DeleteWishlistItem(item.Id))">
                                <i class="bi bi-trash3" /> Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div>
            <input valign="baseline" type="text" placeholder="Url" @bind="@NewItemUrl" @bind:event="oninput">
            <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="async () => await AddNewWishlistItem()" disabled="@IsNewItemUrlEmpty">
                <i class="bi bi-plus-lg" /> Add
            </button>
        </div>
    }
</div>
