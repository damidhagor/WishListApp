@page "/editwishlist"
@rendermode RenderMode.InteractiveServer

<PageTitle>@Wishlist?.Name</PageTitle>

<h2>
    <TextInputToggle Value="@Wishlist?.Name">
        @Wishlist?.Name
    </TextInputToggle>
</h2>

<div>
    @if (Wishlist is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Url</th>
                    <th>Is Bought</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Wishlist.Items)
                {
                    <tr>
                        <td>@item.Url</td>
                        <td>@item.IsBought</td>
                    </tr>
                }

                <tr>
                    <td>
                        <label for="addUrlInput">Add New Item:</label>
                        <input type="text" id="addUrlInput" placeholder="Url">
                    </td>
                    <td></td>
                </tr>
            </tbody>
        </table>

        <div>
            <input valign="baseline" type="text" placeholder="Url" @bind="@NewItemUrl" @bind:event="oninput">
            <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistItem" disabled="@IsNewItemUrlEmpty">
                <i class="bi bi-plus-lg" /> Add
            </button>
        </div>
    }
</div>
