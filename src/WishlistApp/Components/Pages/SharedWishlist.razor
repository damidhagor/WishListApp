@page "/w/{accessKey}"
@rendermode @(new InteractiveServerRenderMode(false))
@attribute [AllowAnonymous]

<PageTitle>@Wishlist?.Name</PageTitle>

<div>
    @if (Wishlist is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlist ...
        </div>
    }
    else
    {
        <h1>@Wishlist.Name</h1>

        <div class="border border-secondary"></div>

        <div class="mt-4 mb-4">
            @foreach (var item in Wishlist.Items)
            {
                <WishlistItemComponent Item="@item"
                    IsEditable="@false"
                    Share="@WishlistShare"
                    ItemBought="@(async (item) => await OnItemBought(item))"
                    ItemUnbought="@(async (item) => await OnItemUnbought(item))" />
            }
        </div>
    }
</div>
