@page "/"
@rendermode RenderMode.InteractiveServer

<PageTitle>Wishlists</PageTitle>

<h2>Wishlists</h2>

<div>
    @if (Lists is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlists ...
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th># Items</th>
                    <th># Shares</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var list in Lists)
                {
                    <tr>
                        <td valign="baseline">
                            <TextInputToggle Value="@list.Name" OnValueAccepted="@((name) => RenameWishlist(@list.Id, name))">
                                <a href="editwishlist?id=@list.Id">@list.Name</a>
                            </TextInputToggle>
                        </td>
                        <td valign="baseline">@list.Items.Count</td>
                        <td valign="baseline">@list.Shares.Count</td>
                        <td valign="baseline">
                            <button type="button" class="btn btn-outline-danger" @onclick="@(async () => await DeleteWishlist(list.Id))">
                                <i class="bi bi-trash3" /> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div>
            <input valign="baseline" type="text" placeholder="Name" @bind="@NewWishlistName" @bind:event="oninput">
            <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="CreateNewWishlist" disabled="@IsNewWishlistNameEmpty">
                <i class="bi bi-plus-lg" /> Add
            </button>
        </div>
    }
</div>
