@page "/"
@rendermode RenderMode.InteractiveServer

<PageTitle>Wishlists</PageTitle>

<h1>Wishlists</h1>

<div class="border border-secondary"></div>

<div>
    @if (Lists is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlists ...
        </div>
    }
    else
    {
        <div class="list-group-flush list-group-hover mb-4">
            @foreach (var list in Lists)
            {
                <div class="list-group-item container-fluid">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4>
                                <span style="z-index: 100; position: relative">
                                    <TextInputToggle Value="@list.Name" OnValueAccepted="@((name) => RenameWishlist(@list.Id, name))">
                                        @list.Name
                                    </TextInputToggle>
                                </span>
                            </h4>
                            <h5>
                                <i class="bi bi-person-fill" /> @list.Shares.Where(s => !s.IsDeleted).Count()
                                <i class="bi bi-hash" /> @list.Items.Length
                            </h5>
                        </div>

                        <div class="col col-auto align-center" style="z-index: 100">
                            <button type="button" class="btn btn-outline-danger" @onclick="@(async () => await DeleteWishlist(list.Id))">
                                <i class="bi bi-trash3" /> Delete
                            </button>
                        </div>

                        <a href="editwishlist?id=@list.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>

        <div>
            <input valign="baseline" type="text" placeholder="Name" @bind="@NewWishlistName" @bind:event="oninput">
            <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="CreateNewWishlist" disabled="@IsNewWishlistNameEmpty">
                <i class="bi bi-plus-lg" /> Add
            </button>
        </div>
    }
</div>
