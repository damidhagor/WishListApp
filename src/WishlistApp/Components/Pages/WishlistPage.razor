@page "/editwishlist"
@page "/w/{accessKey}"
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]

<PageTitle>@_wishlist?.Name</PageTitle>

<div>
    @if (_wishlist is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading Wishlist ...
        </div>
    }
    else
    {
        <WishlistComponent Wishlist="@_wishlist"
                           WishlistShare="@_wishlistShare"
                           WishlistUser="@_user" />
    }
</div>
