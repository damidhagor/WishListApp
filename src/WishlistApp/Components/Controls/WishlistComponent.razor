@inherits ComponentBase
@rendermode @(new InteractiveServerRenderMode(false))

@if (Wishlist is null)
{
    <h1> Unbekannte Wunschliste </h1>

    <div class="border border-secondary"></div>

    <h3 class="m-2 ms-4">
        <i class="bi bi-exclamation-triangle" />
        Diese Wunschliste existiert nicht.
        <i class="bi bi-exclamation-triangle" />
    </h3>
}
else
{
    <AuthorizeView Roles="Admin">
        <Authorized>
            <h1>
                <TextInputToggleComponent Value="@Wishlist.Name" OnValueAccepted="@(name => RenameWishlist(name))">
                    @Wishlist.Name
                </TextInputToggleComponent>
            </h1>
        </Authorized>
        <NotAuthorized>
            <h1>@Wishlist.Name</h1>
        </NotAuthorized>
    </AuthorizeView>

    <div class="border border-secondary"></div>

    @if (Wishlist.Items.Length == 0)
    {
        <h3 class="m-2 ms-4">
            <i class="bi bi-exclamation-circle" />
            Die Wunschliste hat noch keine Einträge.
            <i class="bi bi-exclamation-circle" />
        </h3>
    }
    else
    {
        <div class="d-flex flex-column mt-4 mb-4 gap-2">
            @foreach (var item in _filteredItems)
            {
                <WishlistItemComponent Item="@item"
                                       Share="@WishlistShare"
                                       ItemBought="@(async (item) => await OnItemBought(item))"
                                       ItemUnbought="@(async (item) => await OnItemUnbought(item))" />
            }
        </div>
    }

    <AuthorizeView Roles="Admin">
        <div class="d-flex align-content-center">
            <input class="me-2 col-4" valign="baseline" type="text" placeholder="Url" @bind="@_newItemUrl" @bind:event="oninput">
            <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistItem" disabled="@_isNewItemUrlEmpty">
                <i class="bi bi-plus-lg" /> Hinzufügen
            </button>

            <h5 class="d-flex align-items-center form-check form-switch ms-auto">
                <input class="form-check-input me-2 mb-1" type="checkbox" @bind="_hideBoughtItems" id="hideBoughtItemsCheckBox">
                <label for="hideBoughtItemsCheckBox">
                    Gekaufte Elemente Ausblenden
                </label>
            </h5>
        </div>
    </AuthorizeView>
}
