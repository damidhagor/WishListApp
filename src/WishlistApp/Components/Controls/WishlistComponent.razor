@inherits ComponentBase
@rendermode @(new InteractiveServerRenderMode(false))

@if (Wishlist is null)
{
    <h1> Unbekannte Wunschliste </h1>

    <div class="border border-secondary"></div>

    <h3 class="m-2 ms-4">
        <i class="bi bi-exclamation-triangle" />
        Diese Wunschliste existiert nicht.
        <i class="bi bi-exclamation-triangle" />
    </h3>
}
else
{
    <div class="d-flex align-items-center">
        <h1>
            @if (_viewedByOwner)
            {
                <TextInputToggleComponent Value="@Wishlist.Name" OnValueAccepted="@(name => RenameWishlist(name))">
                    @Wishlist.Name
                </TextInputToggleComponent>
            }
            else
            {
                @Wishlist.Name
            }
        </h1>

        @if (WishlistShare is not null)
        {
            <h2 class="ms-auto">Hallo @WishlistShare.Name</h2>
        }
    </div>

    <div class="border border-secondary"></div>

    @if (Wishlist.Items.Length == 0)
    {
        <h3 class="m-2 ms-4">
            <i class="bi bi-exclamation-circle" />
            Die Wunschliste hat noch keine Einträge.
            <i class="bi bi-exclamation-circle" />
        </h3>
    }
    else
    {
        <div class="d-flex flex-column mt-4 mb-4 gap-2">
            @foreach (var item in GetFilteredWishlistItems())
            {
                <WishlistItemComponent Item="@item"
                                       Share="@WishlistShare"
                                       DisplayOwnerControls="@_viewedByOwner"
                                       DisplayBuyInformation="@(!_hideBuyInformation)"
                                       ItemBought="@(async (item) => await OnItemBought(item))"
                                       ItemUnbought="@(async (item) => await OnItemUnbought(item))"
                                       ItemDeleted="@(async (item) => await OnItemDeleted(item))"
                                       PriorityChanged="@(async (priority) => await OnItemPriorityChanged(item, priority))" />
            }
        </div>
    }

    <div class="d-flex align-content-center align-top">
        @if (_viewedByOwner)
        {
            <input class="me-2 col-4" type="text" placeholder="Url" @bind="@_newItemUrl" @bind:event="oninput">
            <button type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistItem" disabled="@_isNewItemUrlEmpty">
                <i class="bi bi-plus-lg" /> Hinzufügen
            </button>
        }

        <div class="d-flex flex-column justify-content-start ms-auto">
            <h5 class="d-flex align-items-center form-check form-switch">
                <input class="form-check-input me-2 mb-1" type="checkbox" @bind="_hideBoughtItems" id="hideBoughtItemsCheckBox">
                <label for="hideBoughtItemsCheckBox">
                    Gekaufte Produkte Ausblenden
                </label>
            </h5>

            @if (_viewedByOwner)
            {
                <h5 class="d-flex align-items-center form-check form-switch">
                    <input class="form-check-input me-2 mb-1" type="checkbox" @bind="_hideBuyInformation" id="hideBuyInformationCheckBox">
                    <label for="hideBuyInformationCheckBox">
                        Kaufinformationen ausblenden
                    </label>
                </h5>
            }
        </div>
    </div>
}
