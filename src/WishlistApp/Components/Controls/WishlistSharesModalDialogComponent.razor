@inherits ComponentBase
@rendermode @(new InteractiveServerRenderMode(false))

<div class="modal modal-lg fade" id="freigabenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Freigaben</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (Wishlist is null || Wishlist.Shares.Length == 0)
                {
                    <h3 class="m-2 ms-4">
                        <i class="bi bi-exclamation-circle" />
                        Die Wunschliste hat noch keine Freigaben.
                        <i class="bi bi-exclamation-circle" />
                    </h3>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mt-4 mb-4">
                        @foreach (var share in Wishlist.Shares
                       .Where(s => !s.IsDeleted)
                       .OrderBy(s => s.Name))
                        {
                            <WishlistShareComponent Share="@share" ShareDeleted="@(deletedShare => DeleteWishlistShare(deletedShare))" />
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <div class="d-flex flex-row w-100">
                    <input type="text" class="flex-grow-1 me-2" placeholder="Name" @bind="@_newShareName" @bind:event="oninput">
                    <button type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistShare" disabled="@_isNewShareNameEmpty">
                        <i class="bi bi-plus-lg" /> Hinzufügen
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>