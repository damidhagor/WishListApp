@inherits ComponentBase

<div class="dropdown">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @(WishlistItem?.Priority?.Name ?? "")
    </button>
    <ul class="dropdown-menu">
        @foreach (var priority in Priorities)
        {
            <li><button type="button" class="dropdown-item" onclick="@(async () => await PriorityChanged.InvokeAsync(priority.Priority))">@priority.Name</button></li>
        }
    </ul>
</div>
