@inherits ComponentBase
@rendermode @(new InteractiveServerRenderMode(false))
<h2>Freigaben</h2>
<div class="border border-secondary"></div>

@if (Wishlist is null || Wishlist.Shares.Length == 0)
{
    <h3 class="m-2 ms-4">
        <i class="bi bi-exclamation-circle" />
        Die Wunschliste hat noch keine Freigaben.
        <i class="bi bi-exclamation-circle" />
    </h3>
}
else
{
    <div class="d-flex flex-column gap-2 mt-4 mb-4">
        @foreach (var share in Wishlist.Shares.Where(s => !s.IsDeleted))
        {
            <div class="d-flex flex-row align-items-center p-2 rounded-2 border border-secondary border-1">
                <div class="flex-column">
                    <h4>@share.Name</h4>

                    <h5>
                        <a href="@(GetShareUrl(share))">@(GetShareUrl(share))</a>
                        <button type="button" class="btn ms-1" @onclick="async () => await CopyShareUrlToClipboard(share)">
                            <i class="bi bi-copy" />
                        </button>
                    </h5>
                </div>

                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="async () => await DeleteWishlistShare(share)">
                    <i class="bi bi-trash3" /> Löschen
                </button>
            </div>
        }
    </div>
}

<div class="d-flex">
    <input class="me-2 col-4" valign="baseline" type="text" placeholder="Name" @bind="@_newShareName" @bind:event="oninput">
    <button valign="baseline" type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistShare" disabled="@_isNewShareNameEmpty">
        <i class="bi bi-plus-lg" /> Hinzufügen
    </button>
</div>
