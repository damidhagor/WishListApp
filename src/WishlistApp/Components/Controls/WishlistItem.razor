@inherits ComponentBase

@if (Item is not null)
{
    <div class="card border-success mb-3">
        <div class="row g-0">
            <div class="border-end border-success col-md-4">
                <img src="https://www.shop4tesla.com/cdn/shop/products/logo-embleme-in-schwarz-fur-das-tesla-model-y-195398.jpg?format=webp&pad_color=ffffff&v=1671027874&width=1946" class="img-fluid rounded-start">
            </div>

            <div class="col-md-8">
                <h5 class="card-header bg-transparent border-success"><a href="@Item.Url">@Item.Url</a></h5>

                <div class="card-body">
                    <div class="card-title"><a href="@Item.Url">@Item.Url</a></div>

                    <p class="card-text">This is a wider card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.</p>

                    <p class="card-text"><small class="text-body-secondary">Last updated 3 mins ago</small></p>
                </div>
            </div>
        </div>
    </div>

    @* <div class="list-group-item container-fluid rounded-2">
        <div class="row">
            @if (Item.IsBought)
            {
                <div class="col col-auto">
                    <i class="bi bi-bag-fill" />
                </div>
            }
            else
            {
                <div class="col col-auto bg-warning d-flex align-items-center justify-content-center rounded-start-2">
                    <i class="bi bi-bag" />
                </div>
            }

            <div class="col">
                <h4>
                    <a href="@Item.Url" class="stretched-link" target="_blank" rel="noopener noreferrer">@Item.Url</a>
                </h4>
                <h5>
                    Loaded Site Content
                </h5>
            </div>

            <div class="col col-auto" style="z-index: 100">
                @if (IsEditable)
                {
                    <button type="button" class="btn btn-outline-danger mb-2" @onclick="@(async () => await DeleteWishlistItem(item.Id))">
                        <i class="bi bi-trash3" /> Delete
                    </button>
                }

                <div>
                    @if (Item.IsBought)
                    {
                        <div class="badge text-bg-primary">Bought</div>
                    }
                    else
                    {
                        <div class="badge bg-secondary text-bg-success">Not Bought</div>
                    }
                </div>
            </div>
        </div>
    </div> *@
}
