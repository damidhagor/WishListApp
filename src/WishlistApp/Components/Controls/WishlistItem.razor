@inherits ComponentBase
@rendermode RenderMode.InteractiveServer

@if (Item is not null)
{

    <div class="d-flex m-2 overflow-hidden rounded-2 border border-black border-1" style="height: 200px;">
        <div class="d-flex flex-column w-25 overflow-hidden border-black border-end">
            @if (IsProductInformationLoading)
            {
                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                    <img src="@ImageUrl" class="h-100 w-auto">
                </div>
            }
        </div>

        <div class="d-flex flex-column w-75">
            <div class="d-flex flex-row ps-2 pt-2 pe-2 border-bottom border-black">
                <h5 class="">
                    <a href="@Item.Url">@Name</a>
                </h5>

                <div class="ms-auto align-self-baseline">
                    9,95€
                </div>
            </div>

            <div class="d-flex flex-row flex-grow-1 overflow-y-auto ms-2 mt-2 mb-2">
                @Description
            </div>

            <div class="d-flex flex-row justify-content-end align-content-baseline border-top border-black p-2">
                <button type="button" class="btn btn-outline-danger">
                    <i class="bi bi-trash" /> Remove
                </button>

                <button type="button" class="btn btn-primary">
                    <i class="bi bi-bag" /> Mark As Bought
                </button>

                <div class="d-flex rounded-2 ps-4 pe-4 text-bg-success">
                    <span class="text-white align-self-center">
                        <i class="bi bi-bag-fill" /> Bought
                    </span>
                </div>

                <div class="d-flex rounded-2 ps-4 pe-4 text-bg-success">
                    <span class="text-white align-self-center">
                        <i class="bi bi-bag-fill" /> Bought By You
                    </span>
                </div>
            </div>
        </div>
    </div>
}
