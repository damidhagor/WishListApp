@using Microsoft.AspNetCore.Authentication
@using WishlistApp.Identity.Components
@inherits LayoutComponentBase

<div class="page">
    <main>
        <nav class="navbar bg-body-secondary">
            <div class="container-fluid justify-content-start">
                <span class="navbar-brand">Wishlist App</span>

                <AuthorizeView>
                    <Authorized>
                        <a class="nav-link align-self-center me-4" href="/">
                            <i class="bi bi-list navbar-icon"></i> Meine Wunschlisten
                        </a>
                    </Authorized>
                </AuthorizeView>

                <div class="ms-auto">
                    <IdentityHeader />
                </div>
            </div>
        </nav>

        <article class="content px-4 pb-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
