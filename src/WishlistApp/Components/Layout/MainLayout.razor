@inherits LayoutComponentBase

<div class="page">
    <main>
        <AuthorizeView Roles="Admin">
            <nav class="navbar bg-body">
                <div class="container-fluid">
                    <a class="navbar-brand" href="/">Wishlist App</a>

                    <div class="d-flex">
                        <NavLink class="nav-link" href="Account/Manage">
                            <i class="bi bi-person-fill navbar-icon"></i> @context.User.Identity?.Name
                        </NavLink>

                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="Account/Login" />
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-left navbar-icon"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </nav>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
