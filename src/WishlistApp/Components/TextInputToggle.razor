@inherits ComponentBase

@if (!IsInEditMode)
{
    <span>
        @ChildContent

        <button type="button" class="btn text-primary" @onclick="StartEdit">
            <i class="bi bi-pen" />
        </button>
    </span>
}
else
{
    <span>
        <input type="text" @ref="Input" @bind="@EditedValue" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@IsAcceptingValue">
        @if (!IsAcceptingValue)
        {
            <button type="button" class="btn text-primary" @onclick="CancelEdit">
                <i class="bi bi-x-lg" />
            </button>
        }
        else
        {
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
    </span>
}
