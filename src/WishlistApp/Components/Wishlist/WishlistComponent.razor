@inherits ComponentBase
@rendermode @(new InteractiveServerRenderMode(false))

@if (ViewModel?.Wishlist is null)
{
    <h1> Unbekannte Wunschliste </h1>

    <div class="border border-secondary"></div>

    <h3 class="m-2 ms-4">
        <i class="bi bi-exclamation-triangle" />
        Diese Wunschliste existiert nicht.
        <i class="bi bi-exclamation-triangle" />
    </h3>
}
else
{
    <div class="d-flex align-items-center">
        <h1>
            @if (ViewModel.ViewedByOwner)
            {
                <TextEditToggleComponent Value="@ViewModel.Wishlist.Name" OnValueAccepted="RenameWishlist">
                    @ViewModel.Wishlist.Name
                </TextEditToggleComponent>
            }
            else
            {
                @ViewModel.Wishlist.Name
            }
        </h1>

        <div class="d-flex flex-row ms-auto">
            @if (ViewModel.LoggedInShare is not null)
            {
                <h2>Hallo @ViewModel.LoggedInShare.Name</h2>
            }

            <div class="dropdown ms-2">
                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="bi bi-sliders" />
                </button>

                <div class="dropdown-menu" style="min-width: 300px;">
                    <div class="d-flex flex-column p-2 gap-2">
                        <div class="d-flex align-items-center form-check form-switch">
                            <input class="form-check-input me-2 mb-1" type="checkbox" @bind="ViewModel.HideBoughtItems" id="hideBoughtItemsCheckBox">
                            <label for="hideBoughtItemsCheckBox">
                                Gekaufte Produkte Ausblenden
                            </label>
                        </div>

                        @if (ViewModel.ViewedByOwner)
                        {
                            <div class="d-flex align-items-center form-check form-switch">
                                <input class="form-check-input me-2 mb-1" type="checkbox" @bind="ViewModel.HideBuyInformation" id="hideBuyInformationCheckBox">
                                <label for="hideBuyInformationCheckBox">
                                    Kaufinformationen ausblenden
                                </label>
                            </div>

                            <button type="button" class="btn btn-outline-light" @onclick="@(async () => await _shareModal.Open())">
                                <i class="bi bi-person fill" /> Freigaben
                            </button>

                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteBoughtWishlistItems">
                                <i class="bi bi-trash" /> Gekaufte Produkte löschen
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="border border-secondary"></div>

    @if (ViewModel.Wishlist.Items.Length == 0)
    {
        <h3 class="m-2 ms-4">
            <i class="bi bi-exclamation-circle" />
            Die Wunschliste hat noch keine Einträge.
            <i class="bi bi-exclamation-circle" />
        </h3>
    }
    else
    {
        <div class="d-flex flex-column mt-4 mb-4 gap-2">
            @foreach (var item in GetFilteredWishlistItems())
            {
                <CascadingValue Value="item">
                    <ItemComponent />
                </CascadingValue>
            }
        </div>
    }

    <div class="d-flex align-content-center align-top">
        @if (ViewModel.ViewedByOwner)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="AddNewWishlistItem">
                <i class="bi bi-plus-lg" /> Eintrag Hinzufügen
            </button>
        }
    </div>

    <SharesModalComponent @ref="_shareModal" />
    <InputModalComponent @ref="_inputModal" />
}
