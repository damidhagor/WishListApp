@inherits ComponentBase
@rendermode RenderMode.InteractiveServer

@if (Item is not null)
{
    <div class="d-flex rounded-2 border border-secondary border-1" style="height: 200px;">
        <div class="d-flex flex-column w-25 overflow-hidden border-secondary border-end">
            @if (IsProductInformationLoading)
            {
                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                    <img src="@ImageUrl" class="h-100 w-auto">
                </div>
            }
        </div>

        <div class="d-flex flex-column w-75">
            <div class="d-flex flex-row ps-2 pt-2 pe-2 gap-2 border-bottom border-secondary align-items-baseline">
                <h5 class="">
                    <a href="@Item.Url" target="_blank">@(string.IsNullOrWhiteSpace(Item.Name) ? Item.Url : Item.Name)</a>
                </h5>

                <div class="align-self-baseline ms-auto">
                    @Item.Price
                </div>
            </div>

            <div class="d-flex flex-row flex-grow-1 overflow-y-auto ms-2 mt-2 mb-2">
                @Item.Description
            </div>

            <div class="d-flex flex-row gap-2 justify-content-end align-content-baseline border-top border-secondary p-2">
                @if (DisplayOwnerControls)
                {
                    <div class="me-auto">
                        <DropdownComponent T="WishlistItemPriorityDto" Items="Constants.WishlistItemPriorities" SelectedItem="Item.Priority" SelectedItemChanged="PriorityChanged">
                            <ItemTemplate>
                                @context?.Name
                            </ItemTemplate>
                            <EmptySelectionTemplate>
                                Keine Priorität gewählt
                            </EmptySelectionTemplate>
                        </DropdownComponent>
                    </div>

                    <button type="button" class="btn btn-outline-danger" onclick="@(async () => await ItemDeleted.InvokeAsync(Item))">
                        <i class="bi bi-trash" /> Löschen
                    </button>
                    
                    <button type="button" class="btn btn-outline-light" onclick="@(async () => await OpenWishlistItemEditModal(Item))">
                        <i class="bi bi-pen" /> Bearbeiten
                    </button>
                }
                else
                {
                    <div class="d-flex rounded-2 me-auto p-2 border border-rounded-2 border-success text-bg-success-emphasis">
                        <span class="text-white align-self-center">
                            @Item.Priority.Name
                        </span>
                    </div>
                }

                @if (DisplayBuyInformation)
                {
                    @if (Share is not null && Item.BoughtByWishlistShareId is null)
                    {
                        <button type="button" class="btn btn-outline-primary" onclick="@(async () => await ItemBought.InvokeAsync(Item))">
                            <i class="bi bi-bag" /> Als gekauft markieren
                        </button>
                    }
                    else if ((Share is not null && Item.BoughtByWishlistShareId != Share.Id)
                    || (Share is null && Item.BoughtByWishlistShareId is not null))
                    {
                        <div class="d-flex rounded-2 p-2 text-bg-success">
                            <span class="text-white align-self-center">
                                <i class="bi bi-bag-fill" /> Gekauft
                            </span>
                        </div>
                    }
                    else if (Share is not null && Item.BoughtByWishlistShareId == Share.Id)
                    {
                        <button type="button" class="btn btn-outline-warning" onclick="@(async () => await ItemUnbought.InvokeAsync(Item))">
                            <i class="bi bi-bag" /> Als Ungekauft Markieren
                        </button>

                        <div class="d-flex rounded-2 ps-4 pe-4 text-bg-success">
                            <span class="text-white align-self-center">
                                <i class="bi bi-bag-fill" /> Von Dir Gekauft
                            </span>
                        </div>
                    }
                }
            </div>
        </div>
        
        <ItemEditModalComponent @ref="_itemEditModal" ItemUpdated="ItemUpdated" />
    </div>
}
