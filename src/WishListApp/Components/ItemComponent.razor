@inherits ComponentBase

@if (Item is not null)
{
    <div class="d-flex rounded-2 border border-secondary border-1" style="height: 200px;">
        <div class="d-flex flex-column w-25 overflow-hidden border-secondary border-end">
            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                <img src="@Item.ImageUrl" class="h-100 w-auto">
            </div>
        </div>

        <div class="d-flex flex-column w-75">
            <div class="d-flex flex-row ps-2 pt-2 pe-2 gap-2 border-bottom border-secondary align-items-baseline">
                <h5 class="">
                    <a href="@Item.Url" target="_blank">@Item.NameOrUrl</a>
                    @(string.IsNullOrWhiteSpace(Item.SiteName) ? "" : $"({Item.SiteName})")
                </h5>

                @if (Item.Quantity > 1)
                {
                    <div class="align-self-baseline ms-auto">
                        @Item.Quantity Stk.
                    </div>
                }

                @if (Item.Price > 0)
                {
                    <div class="align-self-baseline">
                        @Item.Price @Item.Currency
                    </div>
                }

                @if (ViewModel.ViewedByOwner)
                {
                    <div class="dropdown ms-auto">
                        <div class="" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical" />
                        </div>

                        <div class="dropdown-menu bg-dark-subtle">
                            <div class="d-flex flex-column align-items-stretch px-2 gap-2">
                                <button type="button" class="btn btn-outline-light" @onclick="EditWishListItem">
                                    <i class="bi bi-pen" /> @_localizer["Item_Edit"]
                                </button>

                                <button type="button" class="btn btn-outline-light" @onclick="OpenWishListSelectionModal">
                                    <i class="bi bi-arrow-left-right" /> @_localizer["Item_Move"]
                                </button>

                                @if (!ViewModel.HidePurchaseDetails && _purchasedByOtherShare)
                                {
                                    <button type="button" class="btn btn-outline-warning" @onclick="ResetItemPurchases">
                                        <i class="bi bi-bag" /> @_localizer["Item_ResetPurchaseStatus"]
                                    </button>
                                }

                                <button type="button" class="btn btn-outline-danger" @onclick="DeleteItem">
                                    <i class="bi bi-trash" /> @_localizer["Item_Delete"]
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex flex-row flex-grow-1 overflow-y-auto ms-2 mt-2 mb-2">
                @Item.Description
            </div>

            <div class="d-flex flex-row gap-2 justify-content-end align-content-baseline border-top border-secondary p-2">
                <PriorityComponent Class="me-auto"
                                   @bind-Priority:get="Item.Priority"
                                   @bind-Priority:set="SetItemPriority"
                                   IsReadonly="!ViewModel.ViewedByOwner" />

                @if (!ViewModel.HidePurchaseDetails)
                {
                    @if (_canBePurchased)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="MarkItemAsPurchased">
                            <i class="bi bi-bag" /> @_localizer["Item_MarkAsPurchased"]
                        </button>
                    }

                    if (_purchasedByLoggedInShare > 0)
                    {
                        <button type="button" class="btn btn-outline-warning" @onclick="RevertPurchase">
                            <i class="bi bi-bag" /> @_localizer["Item_RevertPurchase"]
                        </button>

                        <div class="d-flex rounded-2 p-2 text-bg-success">
                            <span class="text-white align-self-center"
                                  title="@(Item.Quantity > 1 ? $"{_purchasedByLoggedInShare}" : "") @_localizer["Item_PurchasedByYou"]">
                                <i class="bi bi-bag-fill" />
                            </span>
                        </div>
                    }

                    else if (_purchasedByOtherShare)
                    {
                        <div class="d-flex rounded-2 p-2 text-bg-success">
                            <span class="text-white align-self-center"
                                  title="@(Item.Quantity > 1 ? $"{Item.PurchasedQuantity}" : "") @_localizer["Item_Purchased"]">
                                <i class="bi bi-bag-fill" />
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        <ItemEditModalComponent @ref="_itemEditModal" />
        <WishListSelectionModalComponent @ref="_wishListSelectionModal" />
        <ConfirmationModalComponent @ref="_confirmationModal" />
    </div>
}
