@inherits ComponentBase

@if (Item is not null)
{
    <div class="item-grid rounded-2 overflow-hidden border border-secondary border-1">

        <div class="item-grid-image border-end border-secondary border-1">

            <div class="item-grid-image-image d-flex overflow-hidden">
                <img class="w-100 object-fit-cover" src="@Item.ImageUrl">
            </div>

            <div class="item-grid-image-badge ms-auto mt-auto mb-1 rounded-start w-75 bg-dark">
                @if (!ViewModel.HidePurchaseDetails)
                {
                    @if (Item.IsPurchasedByShare(ViewModel.LoggedInShare?.Id))
                    {
                        <div class="d-flex flex-row">
                            <div class="d-flex rounded-start-2 px-2 bg-success">
                                <div class="my-auto">
                                    <i class="bi bi-bag-fill" />
                                </div>
                            </div>

                            <div class="flex-grow-1 bg-warning-subtle">
                                <button type="button" class="btn btn-outline-warning w-100 border-start-0 border-end-0 rounded-0" @onclick="ResetItemPurchase">
                                    @_localizer["Item_ResetPurchase"]
                                </button>
                            </div>
                        </div>
                    }
                    else if (Item.IsPurchasedByOtherShare(ViewModel.LoggedInShare?.Id))
                    {
                        <div class="rounded-start-2 p-2 bg-success">
                            <i class="bi bi-bag-fill" />
                            @_localizer["Item_Purchased"]
                        </div>
                    }
                    else
                    {
                        <div class="flex-grow-1 bg-success-subtle rounded-start-2">
                            <button type="button"
                                    class="btn btn-outline-success w-100 border-end-0 rounded-start-2 rounded-0" @onclick="MarkItemAsPurchased">
                                <i class="bi bi-bag" /> @_localizer["Item_MarkAsPurchased"]
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="item-grid-header d-flex flex-column p-1">

            <div class="d-flex flex-row overflow-y-hidden">

                <div class="fs-5">
                    <a href="@Item.Url" target="_blank">@Item.NameOrUrl</a>
                    <span class="text-nowrap">@(string.IsNullOrWhiteSpace(Item.SiteName) ? "" : $"({Item.SiteName})")</span>
                </div>

                @if (ViewModel.ViewedByOwner)
                {
                    <div class="dropdown ms-auto">
                        <div type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical" />
                        </div>

                        <div class="dropdown-menu bg-dark">
                            <div class="d-flex flex-column align-items-stretch px-2 gap-2">
                                <button type="button" class="btn btn-outline-light" @onclick="EditWishListItem">
                                    <i class="bi bi-pen" /> @_localizer["Item_Edit"]
                                </button>

                                <button type="button" class="btn btn-outline-light" @onclick="OpenWishListSelectionModal">
                                    <i class="bi bi-arrow-left-right" /> @_localizer["Item_Move"]
                                </button>

                                @if (!ViewModel.HidePurchaseDetails)
                                {
                                    <button type="button" class="btn btn-outline-warning" @onclick="ResetItemPurchase">
                                        <i class="bi bi-bag" /> @_localizer["Item_ResetPurchaseStatus"]
                                    </button>
                                }

                                <button type="button" class="btn btn-outline-danger" @onclick="DeleteItem">
                                    <i class="bi bi-trash" /> @_localizer["Item_Delete"]
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <div class="d-flex flex-row mt-1">

                <PriorityComponent Class=""
                                   @bind-Priority:get="Item.Priority"
                                   @bind-Priority:set="SetItemPriority"
                                   IsReadonly="!ViewModel.ViewedByOwner" />

                <div class="ms-auto">

                    @if (Item.Price > 0)
                    {
                        <div class="text-nowrap align-self-baseline">
                            @Item.Price @Item.Currency
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="item-grid-description p-1 overflow-y-auto border-top border-secondary border-1">
            @Item.Description
        </div>

        <ItemEditModalComponent @ref="_itemEditModal" />
        <WishListSelectionModalComponent @ref="_wishListSelectionModal" />
        <ConfirmationModalComponent @ref="_confirmationModal" />
    </div>
}
