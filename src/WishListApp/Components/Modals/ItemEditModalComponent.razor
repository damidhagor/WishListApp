@inherits ComponentBase

<ModalComponent @ref="_modal" Title="@_localizer["ItemEditModal_Title"]" Size="ModalComponent.ModalSize.Large">
    <Body>
        <ItemEditComponent @ref="_itemEditComponent" Item="_item" />
    </Body>

    <Footer>
        <LoadingButton LoadingAction="LoadProductInformation">
            @_localizer["ItemEditModal_FetchProductInformation"]
        </LoadingButton>

        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="SaveWishListItem">
            <i class="bi bi-floppy" /> @_localizer["ItemEditModal_Save"]
        </button>
    </Footer>
</ModalComponent>
