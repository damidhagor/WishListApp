@inherits ComponentBase

<ModalComponent @ref="_modal" Title="@_localization.ItemEditModal_Title"
                Size="ModalComponent.ModalSize.Large"
                ModalDialogClass="modal-fullscreen-md-down">
    <Body>
        <ItemEditComponent @ref="_itemEditComponent" Item="_item" />
    </Body>

    <Footer>
        <LoadingButton LoadingAction="LoadProductInformation">
            @_localization.ItemEditModal_FetchProductInformation
        </LoadingButton>

        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="SaveWishListItem">
            <i class="bi bi-floppy" /> @_localization.ItemEditModal_Save
        </button>
    </Footer>
</ModalComponent>
