<HeadContent>
    <script>
        function OpenModal(modalId) {
            var modalElement = document.getElementById(modalId);
            bootstrap.Modal.getOrCreateInstance(modalId).show();
        }

        function CloseModal(modalId) {
            var modalElement = document.getElementById(modalId);
            bootstrap.Modal.getOrCreateInstance(modalId).hide();
        }
    </script>
</HeadContent>

<div class="modal fade @_sizeClass" id="@Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable @ModalDialogClass">
        <div class="modal-content">
            @if (Header is not null || Title is not null || ShowCloseButton)
            {
                <div class="modal-header">
                    @if (Header is not null)
                    {
                        <div>@Header</div>
                    }
                    else
                    {
                        <h2 class="modal-title">@Title</h2>
                    }

                    @if (ShowCloseButton)
                    {
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    }
                </div>
            }

            @if (Body is not null)
            {
                <div class="modal-body">
                    @Body
                </div>
            }

            @if (Footer is not null)
            {
                <div class="modal-footer">
                    @Footer
                </div>
            }
        </div>
    </div>
</div>


