@using WishListApp.Models.Modals

@foreach (var modal in _modals)
{
    @switch (modal)
    {
        case ConfirmationModalContext confirmationContext:
            <ConfirmationModal Context="confirmationContext" AutoShow="true" OnHidden="RemoveModal" />
            break;
        case TextInputModalContext textInputContext:
            <TextInputModal Context="textInputContext" AutoShow="true" OnHidden="RemoveModal" />
            break;
        case SharesModalContext sharesContext:
            <SharesModal Context="sharesContext" AutoShow="true" OnHidden="RemoveModal" />
            break;
        case SelectWishListModalContext selectWishListContext:
            <SelectWishListModal Context="selectWishListContext" AutoShow="true" OnHidden="RemoveModal" />
            break;
        case EditWishListItemModalContext editItemContext:
            <EditWishListItemModal Context="editItemContext" AutoShow="true" OnHidden="RemoveModal" />
            break;
    }
}
