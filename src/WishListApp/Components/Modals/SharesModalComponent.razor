@inherits ComponentBase

<ModalComponent @ref="_modal" Title="@_localizer.SharesModal_Title"
                Size="ModalComponent.ModalSize.Large"
                ModalDialogClass="modal-fullscreen-md-down">
    <Body>
        @if (_shares.Count == 0)
        {
            <h3 class="m-2 ms-4">
                <i class="bi bi-exclamation-circle" />
                @_localizer.SharesModal_Empty
                <i class="bi bi-exclamation-circle" />
            </h3>
        }
        else
        {
            <div class="d-flex flex-column gap-2 m-4">
                @foreach (var share in _shares.OrderBy(s => s.Name))
                {
                    <CascadingValue Value="share">
                        <ShareComponent />
                    </CascadingValue>
                }
            </div>
        }
    </Body>

    <Footer>
        <input type="text" class="flex-grow-1 me-2" placeholder="@_localizer.SharesModal_Add_Placeholder" @bind="@_newShareName" @bind:event="oninput">
        <button type="button" class="btn btn-outline-primary" @onclick="AddNewWishListShare" disabled="@_isNewShareNameEmpty">
            <i class="bi bi-plus-lg" /> @_localizer.SharesModal_Add
        </button>
    </Footer>
</ModalComponent>
