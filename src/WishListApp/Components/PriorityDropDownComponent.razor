<DropdownComponent T="int" Items="WishListItem.AvailablePriorities" 
    @bind-SelectedItem:get="SelectedPriority"
    @bind-SelectedItem:set="SelectedPriorityChanged">
    <ItemTemplate>
        @context.ToDisplayName(_localizer)
    </ItemTemplate>
    <EmptySelectionTemplate>
        @_localizer["PriorityDropDown_NoSelection"]
    </EmptySelectionTemplate>
</DropdownComponent>
