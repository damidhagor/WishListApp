@inherits ComponentBase
@inject IStringLocalizer<Strings> _localizer

@if (!_isInEditMode)
{
    <span>
        @ChildContent

        <button type="button" class="btn text-primary" @onclick="StartEdit">
            <i class="bi bi-pen" />
        </button>
    </span>
}
else
{
    <span>
        <input type="text" @ref="_input" @bind="@_editedValue" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_isAcceptingValue">
        @if (!_isAcceptingValue)
        {
            <button type="button" class="btn text-primary" @onclick="CancelEdit">
                <i class="bi bi-x-lg" />
            </button>
        }
        else
        {
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">@_localizer["Loading"] ...</span>
            </div>
        }
    </span>
}
