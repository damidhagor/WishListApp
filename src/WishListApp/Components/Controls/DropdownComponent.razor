@typeparam T
@inherits ComponentBase

<div class="dropdown">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @if (SelectedItem is not null)
        {
            @if (ItemTemplate is not null)
            {
                <span>@ItemTemplate(SelectedItem)</span>
            }
            else
            {
                <span>@SelectedItem.ToString()</span>
            }
        }
        else
        {
            @if (EmptySelectionTemplate is not null)
            {
                <span>@EmptySelectionTemplate</span>
            }
            else
            {
                <span>@_localizer["DropDown_EmptyText"]</span>
            }
        }
    </button>
    <ul class="dropdown-menu">
        @foreach (var item in Items)
        {
            <li>
                <button type="button" class="dropdown-item" @onclick="() => UpdateSelectedItem(item)">
                    @if (ItemTemplate is not null)
                    {
                        <span>@ItemTemplate(item)</span>
                    }
                    else
                    {
                        <span>@(item?.ToString() ?? "")</span>
                    }
                </button>
            </li>
        }
    </ul>
</div>
