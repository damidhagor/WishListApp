@page "/"
@attribute [Authorize]

<PageTitle>@_localization.WishListsPage_Title</PageTitle>

<div class="d-flex flex-column mx-auto" style="max-width: 1000px">
    <div class="d-flex flex-row flex-wrap align-content-center column-gap-2">
        <div class="fs-1 me-auto">@_localization.WishListsPage_Title</div>

        @if (_wishLists is not null)
        {
            <button type="button" class="btn btn-outline-primary my-auto" @onclick="CreateNewWishList">
                <i class="bi bi-plus-lg" /> @_localization.Add
            </button>
        }
    </div>

    <div class="border border-secondary mt-2 mb-4"></div>

    <div>
        @if (_wishLists is null)
        {
            <div>
                <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                    <span class="visually-hidden">@_localization.Loading ...</span>
                </div>
                @_localization.WishListsPage_LoadingWishLists ...
            </div>
        }
        else
        {
            <div class="mt-4 mb-4">
                @foreach (var (wishList, shares) in _wishLists)
                {
                    <div class="d-flex flex-row m-2 p-2 rounded-2 border border-secondary border-1" style="position: relative">
                        <div class="d-flex flex-column">
                            <h4 style="z-index: 100; position: relative">
                                @wishList.Name
                            </h4>

                            <h5 class="mt-auto">
                                <i class="bi bi-person-fill" /> @shares.Count()
                                <i class="bi bi-hash" /> @wishList.Items.Length
                            </h5>
                        </div>

                        <div class="d-flex flex-column ms-auto gap-2">
                            <button type="button" class="btn btn-outline-light" style="z-index: 100" @onclick="async () => await RenameWishList(wishList)">
                                <i class="bi bi-pen" /> @_localization.WishListsPage_Rename
                            </button>

                            <button type="button" class="btn btn-outline-danger" style="z-index: 100" @onclick="async () => await DeleteWishList(wishList.Id)">
                                <i class="bi bi-trash3" /> @_localization.Delete
                            </button>
                        </div>

                        <a href="wishlist?id=@wishList.Id" class="stretched-link"></a>
                    </div>
                }
            </div>
        }
    </div>

    <TextInputModalComponent @ref="_inputModal" />
    <ConfirmationModalComponent @ref="_confirmationModal" />
</div>