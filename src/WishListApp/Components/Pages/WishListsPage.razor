@page "/"
@attribute [Authorize]

<PageTitle>@_localizer["WishListsPage_Title"]</PageTitle>

<div class="d-flex flex-row flex-wrap align-content-center column-gap-2">
    <div class="fs-1 me-auto">@_localizer["WishListsPage_Title"]</div>

    @if (_wishLists is not null)
    {
        <div>
            <button type="button" class="btn btn-outline-primary align-middle" @onclick="CreateNewWishList">
                <i class="bi bi-plus-lg" /> @_localizer["Add"]
            </button>
        </div>
    }
</div>

<div class="border border-secondary mt-2 mb-4"></div>

<div>
    @if (_wishLists is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">@_localizer["Loading"] ...</span>
            </div>
            @_localizer["WishListsPage_LoadingWishLists"] ...
        </div>
    }
    else
    {
        <div class="mt-4 mb-4">
            @foreach (var (wishList, shares) in _wishLists)
            {
                <div class="d-flex flex-row m-2 align-items-center p-2 rounded-2 border border-secondary border-1" style="position: relative">
                    <div class="flex-column">
                        <h4 style="z-index: 100; position: relative">
                            <TextEditToggleComponent Value="@wishList.Name" OnValueAccepted="@((name) => RenameWishList(wishList.Id, name))">
                                @wishList.Name
                            </TextEditToggleComponent>
                        </h4>

                        <h5>
                            <i class="bi bi-person-fill" /> @shares.Count()
                            <i class="bi bi-hash" /> @wishList.Items.Length
                        </h5>
                    </div>

                    <button type="button" class="btn btn-outline-danger ms-auto" style="z-index: 100" @onclick="@(async () => await DeleteWishList(wishList.Id))">
                        <i class="bi bi-trash3" /> @_localizer["Delete"]
                    </button>

                    <a href="wishlist?id=@wishList.Id" class="stretched-link"></a>
                </div>
            }
        </div>
    }
</div>

<TextInputModalComponent @ref="_inputModal" />
<ConfirmationModalComponent @ref="_confirmationModal" />