@page "/wishlist"
@page "/w/{accessKey}"
@attribute [AllowAnonymous]

<PageTitle>@_viewModel?.WishList?.Name</PageTitle>

<div class="mx-auto" style="max-width: 1000px" >
    @if (_viewModel?.WishList is null)
    {
        <div>
            <div class="spinner-border spinner-border-sm text-primary ms-1" role="status">
                <span class="visually-hidden">@_localization.Loading ...</span>
            </div>
            @_localization.WishListPage_LoadingWishList ...
        </div>
    }
    else
    {
        <CascadingValue Value="_viewModel">
            <WishListComponent />
        </CascadingValue>
    }
</div>
