@inherits ComponentBase

<div class="d-flex flex-row align-items-center p-2 rounded-2 border border-secondary border-1">
    <div class="flex-column">
        <h4>@Share.Name</h4>

        <div class="d-flex flex-row flex-wrap fs-6 gap-2">
            @_localizer.ShareComponent_AccessKey:
            <a href="@Url" class="">@Share.AccessKey</a>
        </div>
    </div>

    <div class="d-flex flex-column flex-shrink-0 ms-auto gap-2">
        <button type="button" class="btn btn-outline-light" @onclick="CopyShareUrlToClipboard">
            <i class="bi bi-copy" /> @_localizer.ShareComponent_CopyLink
        </button>

        <button type="button" class="btn btn-outline-danger" @onclick="DeleteShare">
            <i class="bi bi-trash3" /> @_localizer.ShareComponent_Delete
        </button>
    </div>
</div>

<ConfirmationModalComponent @ref="_modal" />