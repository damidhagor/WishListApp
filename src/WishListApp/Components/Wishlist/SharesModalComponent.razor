@inherits ComponentBase

<ModalComponent @ref="_modal" Title="Freigaben" Size="ModalComponent.ModalSize.Large">
    <Body>
        @if (_shares.Count == 0)
        {
            <h3 class="m-2 ms-4">
                <i class="bi bi-exclamation-circle" />
                Die Wunschliste hat noch keine Freigaben.
                <i class="bi bi-exclamation-circle" />
            </h3>
        }
        else
        {
            <div class="d-flex flex-column gap-2 mt-4 mb-4">
                @foreach (var share in _shares.OrderBy(s => s.Name))
                {
                    <CascadingValue Value="share">
                        <ShareComponent />
                    </CascadingValue>
                }
            </div>
        }
    </Body>

    <Footer>
        <input type="text" class="flex-grow-1 me-2" placeholder="Name" @bind="@_newShareName" @bind:event="oninput">
        <button type="button" class="btn btn-outline-primary" @onclick="AddNewWishListShare" disabled="@_isNewShareNameEmpty">
            <i class="bi bi-plus-lg" /> Hinzufügen
        </button>
    </Footer>
</ModalComponent>
