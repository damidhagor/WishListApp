@inherits ComponentBase

<div class="d-flex flex-row align-items-center p-2 rounded-2 border border-secondary border-1">
    <div class="flex-column">
        <h4>@Share.Name</h4>

        <h5>
            <a href="@Url">@Url</a>
            <button type="button" class="btn ms-1" @onclick="CopyShareUrlToClipboard">
                <i class="bi bi-copy" />
            </button>
        </h5>
    </div>

    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="DeleteShare">
        <i class="bi bi-trash3" /> Löschen
    </button>
</div>
