@using Microsoft.AspNetCore.Authentication
@using WishListApp.Identity.Components
@inherits LayoutComponentBase

<div class="page">
    <main>
        <nav class="navbar sticky-top bg-body-secondary">
            <div class="container-fluid justify-content-start">
                <span class="navbar-brand">@_localization.AppName</span>

                <AuthorizeView>
                    <Authorized>
                        <a class="nav-link align-self-center me-4" href="/">
                            <i class="bi bi-list navbar-icon"></i> @_localization.MainLayout_MyWishLists
                        </a>
                    </Authorized>
                </AuthorizeView>

                <div class="ms-auto me-2">
                    <IdentityHeader />
                </div>
            </div>
        </nav>

        <article class="content px-4 pb-4">
            <MigrationDisplay>
                @Body
            </MigrationDisplay>
        </article>
    </main>
</div>

<ModalDisplay />

<div id="blazor-error-ui">
    @_localization.MainLayout_Error_Message
    <a href="" class="reload">@_localization.MainLayout_Error_Reload</a>
    <a class="dismiss">@_localization.MainLayout_Error_Dismiss</a>
</div>
