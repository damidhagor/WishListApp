@using Microsoft.AspNetCore.Authentication
@using WishListApp.Identity.Components
@inherits LayoutComponentBase
@inject IStringLocalizer<Localization> _localizer

<div class="page">
    <main>
        <nav class="navbar bg-body-secondary">
            <div class="container-fluid justify-content-start">
                <span class="navbar-brand">@_localizer["AppName"]</span>

                <AuthorizeView>
                    <Authorized>
                        <a class="nav-link align-self-center me-4" href="/">
                            <i class="bi bi-list navbar-icon"></i> @_localizer["MainLayout_MyWishLists"]
                        </a>
                    </Authorized>
                </AuthorizeView>

                <div class="ms-auto">
                    <IdentityHeader />
                </div>
            </div>
        </nav>

        <article class="content px-4 pb-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    @_localizer["MainLayout_Error_Message"]
    <a href="" class="reload">@_localizer["MainLayout_Error_Reload"]</a>
    <a class="dismiss">@_localizer["MainLayout_Error_Dismiss"]</a>
</div>
