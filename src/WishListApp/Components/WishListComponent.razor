@inherits ComponentBase

@if (ViewModel?.WishList is null)
{
    <h1> @_localizer.WishList_Unknown_Title </h1>

    <div class="border border-secondary"></div>

    <h3 class="m-2 ms-4">
        <i class="bi bi-exclamation-triangle" />
        @_localizer.WishList_Unknown_Message
        <i class="bi bi-exclamation-triangle" />
    </h3>
}
else
{
    <div class="d-flex flex-row flex-wrap align-items-center">
        <div class="fs-1 my-auto">
            @ViewModel.WishList.Name
        </div>

        <div class="d-flex flex-row flex-shrink-0 ms-auto">
            @if (ViewModel.LoggedInShare is not null)
            {
                <div class="fs-2 me-4">
                    @_localizer.WishList_ShareGreeting @ViewModel.LoggedInShare.Name
                </div>
            }

            @if (ViewModel.ViewedByOwner)
            {
                <button type="button" class="btn btn-outline-primary my-auto" @onclick="AddNewWishListItem">
                    <i class="bi bi-plus-lg" /> @_localizer.Add
                </button>
            }

            <div class="dropdown ms-2 my-auto">
                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="bi bi-sliders" />
                </button>

                <div class="dropdown-menu" style="min-width: 300px;">
                    <div class="d-flex flex-column p-2 gap-2">
                        <div class="d-flex align-items-center form-check form-switch">
                            <input class="form-check-input me-2 mb-1" type="checkbox" @bind="ViewModel.HidePurchasedItems" id="hidePurchasedItemsCheckBox">
                            <label for="hidePurchasedItemsCheckBox">
                                @_localizer.WishList_Settings_HidePurchasedItems
                            </label>
                        </div>

                        @if (ViewModel.ViewedByOwner)
                        {
                            <div class="d-flex align-items-center form-check form-switch">
                                <input class="form-check-input me-2 mb-1" type="checkbox" @bind="ViewModel.HidePurchaseDetails" id="hidePurchaseDetailsCheckBox">
                                <label for="hidePurchaseDetailsCheckBox">
                                    @_localizer.WishList_Settings_HidePurchaseDetails
                                </label>
                            </div>

                            <button type="button" class="btn btn-outline-light" @onclick="RenameWishList">
                                <i class="bi bi-pen fill" /> @_localizer.WishList_Settings_Rename
                            </button>

                            <button type="button" class="btn btn-outline-light" @onclick="async () => await _shareModal.Open()">
                                <i class="bi bi-person fill" /> @_localizer.WishList_Settings_Shares
                            </button>

                            <button type="button" class="btn btn-outline-danger" @onclick="DeletePurchasedWishListItems">
                                <i class="bi bi-trash" /> @_localizer.WishList_Settings_DeletePurchasedItems
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="border border-secondary mt-2 mb-4"></div>

    @if (ViewModel.WishList.Items.Length == 0)
    {
        <h3 class="m-2 ms-4">
            <i class="bi bi-exclamation-circle" />
            @_localizer.WishList_Empty
            <i class="bi bi-exclamation-circle" />
        </h3>
    }
    else
    {
        <div class="d-flex flex-column mt-4 mb-4 gap-2">
            @foreach (var item in GetFilteredWishListItems())
            {
                <CascadingValue Value="item">
                    <ItemComponent />
                </CascadingValue>
            }
        </div>
    }

    <SharesModalComponent @ref="_shareModal" />
    <TextInputModalComponent @ref="_inputModal" />
    <ConfirmationModalComponent @ref="_confirmationModal" />
}
