@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using WishListApp.Identity.Services

@inject IStringLocalizer<Localization> _localizer
@inject IIdentityService _accountService

<div class="d-flex">
    <AuthorizeView>
        <Authorized>
            <a href="account/profile" class="nav-link align-self-center me-4">
                <i class="bi bi-person-fill navbar-icon"></i> @GetUsername(context)
            </a>

            <button class="btn btn-outline-light" onclick="@(() => _accountService.Logout())">
                <i class="bi bi-box-arrow-left navbar-icon"></i> @_localizer["IdentityHeader_Logout"]
            </button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-outline-light" onclick="@(() => _accountService.Login())">
                <i class="bi bi-box-arrow-in-right navbar-icon"></i> @_localizer["IdentityHeader_Login"]
            </button>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string GetUsername(AuthenticationState authenticationState)
    {
        var user = authenticationState.User;

        var nameClaim = user.Claims.FirstOrDefault(c => c.Type == "name");
        return nameClaim?.Value ?? user.Identity?.Name ?? "";
    }
}